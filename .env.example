# Copy this file to .env and fill in real values. Never commit .env itself.

# Postgres (used by docker-compose and backend application.yml)
POSTGRES_DB=ai_quote
POSTGRES_USER=ai_quote
POSTGRES_PASSWORD=change-me

# MinIO (S3-compatible object storage, used by docker-compose and backend StorageService)
MINIO_ROOT_USER=ai_quote
MINIO_ROOT_PASSWORD=change-me

# Anthropic API (used by backend AiClient)
ANTHROPIC_API_KEY=

# JWT signing secret for contractor auth (backend). REQUIRED in production — the app
# falls back to a well-known, publicly-visible dev-only value if this is left unset (see
# application.yml), which lets anyone forge a valid token. Generate a long random value,
# e.g.: openssl rand -base64 48
JWT_SECRET=

# SMTP (used by backend EmailService to send owner notifications and client offers)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# CORS — comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Public URL the frontend is served from (used to build links in emails)
FRONTEND_URL=http://localhost:5173

# Stripe (used by backend BillingService for the trial -> paid-plan flow). Get these
# from the Stripe Dashboard (test mode while developing): API keys page for the secret
# key, Developers -> Webhooks for the signing secret (point the endpoint at
# https://<your-domain>/api/billing/webhook, subscribed to checkout.session.completed,
# customer.subscription.updated, customer.subscription.deleted), and Product catalog for
# the three recurring Price IDs (create one Product+Price per plan: Starter 49 PLN/mo,
# Growth 129 PLN/mo, Pro 299 PLN/mo). Until these are set, trial signup/usage works
# fully but Checkout/Billing Portal/webhooks will fail cleanly (BillingException).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=

# Google sign-in (used by backend GoogleAuthService to verify ID tokens, and by the
# frontend's Google Identity Services button). Get this from Google Cloud Console ->
# APIs & Services -> Credentials -> "Create Credentials" -> "OAuth client ID" -> type
# "Web application" -> add your frontend origin(s) (e.g. http://localhost:5173, and your
# real domain in production) under "Authorized JavaScript origins". Same value goes in
# both variables below — the backend uses it to verify token audience, the frontend
# uses it to request the token in the first place. VITE_GOOGLE_CLIENT_ID is baked in at
# build time, so changing it requires `docker compose build frontend`, not just a restart.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
